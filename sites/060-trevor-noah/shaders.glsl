        uniform float uAspect;

        uniform vec3 uBendOrigin;
        uniform vec3 uBendAxis;
        uniform vec3 uBendNormal;
        uniform float uBendStrength;

        varying float vBend;
        varying vec2 vUv;
        varying vec2 vNDC;

        void main() {
          vec3 pos = position;

          /* 
            Bend
          */
          vec3 axis = normalize(uBendAxis);
          vec3 nrm  = normalize(uBendNormal);
          float dSigned = dot(pos - uBendOrigin, axis);

          float bendAmount = 0.0;
          
          if (dSigned > 0.0) {
            const float BEND_ANGLE_MAX = 3.141592;
            float k       = uBendStrength;
            float radius  = 1.0 / k;
            vec3  perp    = pos - uBendOrigin - axis * dSigned;
            float theta   = dSigned * k;
            float thetaC  = min(theta, BEND_ANGLE_MAX);
            float excess  = max(0.0, dSigned - BEND_ANGLE_MAX / k);

            pos = uBendOrigin + perp + axis * sin(thetaC) * radius + nrm  * (1.0 - cos(thetaC)) * radius - axis * excess;

            bendAmount = thetaC / BEND_ANGLE_MAX;
          }

          /* 
            Top
          */
          #if IS_TOP
            pos.y -= 0.015;
          #endif

          /*
            Output
          */
          gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);

          vBend = bendAmount;
          vUv = uv;
          vNDC = (gl_Position.xy / gl_Position.w) * 0.5 + 0.5;
        }
      

