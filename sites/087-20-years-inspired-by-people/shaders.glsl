precision highp float;

// Simplex 2D noise
vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }

float snoise(vec2 v){
  const vec4 C = vec4(0.211324865405187, 0.366025403784439,
           -0.577350269189626, 0.024390243902439);
  vec2 i  = floor(v + dot(v, C.yy) );
  vec2 x0 = v -   i + dot(i, C.xx);
  vec2 i1;
  i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 ))
  + i.x + vec3(0.0, i1.x, 1.0 ));
  vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy),
    dot(x12.zw,x12.zw)), 0.0);
  m = m*m ;
  m = m*m ;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
  vec3 g;
  g.x  = a0.x  * x0.x  + h.x  * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

uniform float u_time;

uniform vec3 u_color1;
uniform vec3 u_color2;
uniform vec3 u_color3;
uniform vec3 u_color4;

varying vec2 vUv;

void main() {
    vec2 uv = vUv;

    // Animated noise for organic movement
    float noise = snoise(uv * 2.0 + (u_time / 6.)) * 0.2;
    float noise2 = snoise(uv * 1.0 - (u_time / 10.)) * 0.15;

    // Animated glow center - moves in a slow, organic pattern
    float t = u_time * 0.15;
    vec2 glowCenter = vec2(
        0.2 + sin(t) * 0.15 + cos(t * 0.7) * 0.1,
        0.25 + cos(t * 0.8) * 0.2 + sin(t * 0.5) * 0.1
    );
    
    // Secondary subtle glow for more complexity
    vec2 glowCenter2 = vec2(
        0.7 + sin(t * 0.6 + 1.5) * 0.2,
        0.6 + cos(t * 0.4 + 0.8) * 0.25
    );
    
    float dist1 = distance(uv, glowCenter);
    float dist2 = distance(uv, glowCenter2);
    
    // Combine distances for multi-point glow effect
    float radialFactor = smoothstep(0.0, 1.0, dist1) * 0.7 + smoothstep(0.0, 1.3, dist2) * 0.3;
    
    // Add noise for organic feel
    float finalFactor = clamp(radialFactor + noise + noise2, 0.0, 1.0);
    
    // Blend from bright to dark based on combined distance
    vec3 brightColor = mix(u_color1, u_color2, smoothstep(0.0, 0.8, uv.y + noise * 0.3));
    vec3 darkColor = mix(u_color3, u_color4, smoothstep(0.2, 1.0, uv.y - noise2 * 0.2));
    vec3 mixFinal = mix(brightColor, darkColor, finalFactor);

    gl_FragColor.rgb = mixFinal;
    gl_FragColor.a = 1.;
}


